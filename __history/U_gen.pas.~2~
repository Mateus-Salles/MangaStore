var
  frmGen: TfrmGen;

implementation

{$R *.dfm}

uses U_DM;

procedure TfrmGen.pnlSalvarClick(Sender: TObject);
var
  I: integer;
  gens: string;
begin
  gens := '';

  if rgPublicoAlvo.ItemIndex = -1 then
  begin
    ShowMessage('Escolha um Público Alvo');
    Exit;
  end
  else
  begin
    gens := gens + rgPublicoAlvo.Items[rgPublicoAlvo.ItemIndex] + ', ';
  end;

  for I := 0 to ComponentCount - 1 do
  begin
    if Components[I] is TCheckBox then
    begin
      if TCheckBox(Components[I]).Checked then
      begin
        gens := gens + TCheckBox(Components[I]).Caption + ', ';
      end;
    end;
  end;

  gens := ReverseString(StringReplace(ReverseString(gens), reverseString(', '), '', [rfReplaceAll], 1));

  ShowMessage(gens);

end;

end.
