    gb2: TGroupBox;
    pnlSalvar: TPanel;
    pnlVoltar: TPanel;
    cbArtM: TCheckBox;
    cbAvantG: TCheckBox;
    cbCybP: TCheckBox;
    cbEsp: TCheckBox;
    cbFar: TCheckBox;
    cbFant: TCheckBox;
    cbJogos: TCheckBox;
    cbGuerra: TCheckBox;
    cbHist: TCheckBox;
    cbParod: TCheckBox;
    cbSlicOfLife: TCheckBox;
    cbMusic: TCheckBox;
    cbPolic: TCheckBox;
    cbSobNat: TCheckBox;
    cbNamM: TCheckBox;
