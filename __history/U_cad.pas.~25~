unit U_cad;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.DBCtrls, Vcl.ExtCtrls, U_DM,
  Vcl.Mask, U_func, Vcl.Buttons;

procedure cadUsua();

type
  TfrmCadastro = class(TForm)
    pnlFundo: TPanel;
    pnlImage: TPanel;
    Image1: TImage;
    txtNome: TEdit;
    lbNome: TLabel;
    pnlProximo: TPanel;
    pnlVoltar: TPanel;
    lbTelefone: TLabel;
    lbEndereco: TLabel;
    txtEndereco: TEdit;
    txtTelefone: TMaskEdit;
    txtEmail: TEdit;
    lbEmail: TLabel;
    lbSenha: TLabel;
    txtSenha: TEdit;
    oPD: TOpenDialog;
    btnProximo: TSpeedButton;
    btnVoltar: TSpeedButton;
    pnlCarImage: TPanel;
    btnCarImage: TSpeedButton;
    procedure pnlVoltarClick(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure btnProximoClick(Sender: TObject);
    procedure btnCarImageClick(Sender: TObject);
    procedure btnVoltarClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmCadastro: TfrmCadastro;
  nome, endereco, email, tel, senha: string;

implementation

{$R *.dfm}

uses U_home, U_log;

procedure TfrmCadastro.pnlVoltarClick(Sender: TObject);
begin
  frmCadastro.Visible := false;
  frmLogin.Visible := true;
end;

procedure TfrmCadastro.btnCarImageClick(Sender: TObject);
begin
  resizeImage(Image1, 104, 104, oPD, true);
end;

procedure TfrmCadastro.btnProximoClick(Sender: TObject);
begin
  if txtNome.Text = '' then
  begin
    ShowMessage('Nome em branco');
    exit;
  end
  else if txtTelefone.Text = '' then
  begin
    ShowMessage('Telefone em branco');
    exit;
  end
  else if txtEndereco.Text = '' then
  begin
    ShowMessage('Endereço em branco');
    exit;
  end
  else if txtEmail.Text = '' then
  begin
    ShowMessage('Email em branco');
    exit;
  end
  else if txtSenha.Text = '' then
  begin
    ShowMessage('Senha em branco');
    exit;
  end
  else if Image1.Picture.Graphic = nil then
  begin
    ShowMessage('Sem foto');
    exit;
  end
  else
  begin
    nome := txtNome.Text;
    tel := txtTelefone.Text;
    endereco := txtEndereco.Text;
    email := txtEmail.Text;
    senha := txtSenha.Text;
  end;

  try
    cadUsua();
    DM.sqlCliente.SQL.Text := 'select id_cliente, nome from cliente where nome=:nome';
    DM.sqlCliente.Params.ParamByName('nome').AsString := txtNome.Text;
    DM.sqlCliente.Open;
    RenameFile(GetDiretorio() + '\imagens\usuario\' + 'user' + '.jpg', GetDiretorio() + '\imagens\usuario\' + DM.sqlCliente.FieldByName('id_cliente').AsString + DM.sqlCliente.FieldByName('nome').AsString + '.jpg');
    frmHome.diret := GetDiretorio() + '\imagens\usuario\' + DM.sqlCliente.FieldByName('id_cliente').AsString + DM.sqlCliente.FieldByName('nome').AsString + '.jpg';
  Except
    ShowMessage('Houve um erro ao renomear a imagem');
  end;

end;

procedure TfrmCadastro.btnVoltarClick(Sender: TObject);
begin
  frmLogin.Show;
  frmCadastro.Close;
end;

procedure TfrmCadastro.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  frmLogin.Visible := true;
end;

procedure cadUsua();
begin
  with DM.sqlCliente do
  begin
    try
      SQL.Text := 'INSERT INTO cliente(nome, endereco, email, telefone, senha)';
      SQL.Add('VALUES (:nome, :endereco, :email, :telefone, :senha)');

      Params.ParamByName('nome').AsString := nome;
      Params.ParamByName('endereco').AsString := endereco;
      Params.ParamByName('email').AsString := email;
      Params.ParamByName('telefone').AsString := tel;
      Params.ParamByName('senha').AsString := senha;

      ExecSQL;

      frmCadastro.Visible := false;
      frmLogin.Show;
      frmCadastro.Close;
    Except
      ShowMessage('Erro ao cadastrar usuário');
    end;

    DM.sqlCliente.SQL.Text := 'select * from cliente'
  end;
end;

end.
