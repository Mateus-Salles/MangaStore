unit U_compra;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Vcl.StdCtrls, Vcl.Buttons;

type
  TfrmCompra = class(TForm)
    Panel1: TPanel;
    Image1: TImage;
    Panel2: TPanel;
    pnlNome: TPanel;
    pnlPreco: TPanel;
    lbNome: TLabel;
    lbAutor: TLabel;
    Panel3: TPanel;
    lbGeneros: TLabel;
    btnCompra: TPanel;
    lbPreco: TLabel;
    Panel4: TPanel;
    lbEstDisponivel: TLabel;
    Panel5: TPanel;
    lbEst: TLabel;
    lbEstQuantDis: TLabel;
    pnlVoltar: TPanel;
    SpeedButton1: TSpeedButton;
    lbEditora: TLabel;
    lbAno: TLabel;
    Panel6: TPanel;
    procedure FormShow(Sender: TObject);
    procedure SpeedButton1Click(Sender: TObject);
    procedure btnCompraClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }

    nomeImg, id, preco, autor, gens, estoque, editora, ano: string;
  end;

var
  frmCompra: TfrmCompra;

implementation

{$R *.dfm}

uses U_func, U_DM, U_home, U_log;

procedure TfrmCompra.btnCompraClick(Sender: TObject);
begin
  with frmHome do
  begin
    if not logado then
    begin
      frmLogin.ShowModal;
    end
    else
    begin

    end;
  end;

end;

procedure TfrmCompra.FormShow(Sender: TObject);
begin
  lbNome.Caption := nomeImg;
  lbAutor.Caption := 'Criado por '+autor;
  lbEditora.Caption := 'Editora '+editora;
  lbGeneros.Caption := gens;
  if StrToInt(estoque) > 0 then
  begin
    lbEstDisponivel.Caption := 'ESTOQUE DISPONÍVEL';
  end
  else
  begin
    lbEstDisponivel.Caption := 'SEM ESTOQUE';
  end;
  lbEst.Caption := estoque;
  lbAno.Caption := 'Publicado no ano de '+ano;
  lbPreco.Caption := Format('R$%.2f', [StrToFloat(preco)]);

  Image1.Picture.LoadFromFile(GetDiretorio() + '\imagens\manga\' + id + renameImage() + '.jpg')
end;

procedure TfrmCompra.SpeedButton1Click(Sender: TObject);
begin
  frmHome.Show;
  frmCompra.Close;
end;

end.
