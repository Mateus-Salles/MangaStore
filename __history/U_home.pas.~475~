procedure loadManga;
var
  I: integer;
begin

  SetLength(id, 0);

  DM.sqlManga.SQL.Text := 'select * from mangas';
  DM.sqlManga.Open;

  for I := 0 to DM.sqlManga.RecordCount -1 do
  begin
    if not (Length(id) = DM.sqlManga.RecordCount) then
    begin
      SetLength(id, Length(id)+1);
      SetLength(nami, Length(nami)+1);
      id[I] := DM.sqlManga.FieldByName('id_manga').AsInteger;
      nami[I] := DM.sqlManga.FieldByName('titulo').AsString;
      DM.sqlManga.Next;
    end;
  end;
end;

procedure apagar();
var
  I: integer;
  comp: TComponent;
begin
  for I := frmHome.screen.ControlCount -1 Downto 0 do
  begin
    comp := frmHome.screen.Controls[I];

    if not (comp.Name = 'pnlPop') then
    begin
      comp.Free;
    end;
  end;
end;

procedure TfrmHome.compraManga(Sender: TObject);
var
  Componente: TPanel;
  c: integer;
begin
  Componente := Sender as TPanel;

  with DM.sqlManga do
  begin
    SQL.Text := 'SELECT * FROM mangas WHERE id_manga = :idM';
    ParamByName('idM').AsInteger := id[Componente.Tag];
    Open;

    frmCompra.id := FieldByName('id_manga').AsString;
    frmCompra.nomeImg := FieldByName('titulo').AsString;
    frmCompra.preco := FieldByName('preco').AsString;
    frmCompra.autor := FieldByName('autor').AsString;
    frmCompra.gens := FieldByName('genero').AsString;
    frmCompra.estoque := FieldByName('estoque').AsString;
    frmCompra.editora := FieldByName('editora').AsString;
    frmCompra.ano := FieldByName('ano_publi').AsString;
  end;

  frmCompra.ShowModal;
end;

function renameImage():string;
var
  texto: string;
  j, o: integer;
begin
  texto := '';

  for j := 1 to Length(DM.sqlManga.FieldByName('titulo').AsString) do
  begin
    for o := 1 to 10 do
    begin
      if o = 10 then break;
      if (DM.sqlManga.FieldByName('titulo').AsString[j] = ar[o]) then break;
    end;

    if o = 10 then texto := texto + DM.sqlManga.FieldByName('titulo').AsString[j];

  end;

  Result := texto;
end;

