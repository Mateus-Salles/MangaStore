    pnlLogin.Visible := false;
    pnlUsua.Visible := true;
  end;

  apagar();

  loadManga;

  showManga(60, false);

  //Painel NOVIDADE
  pnlNov := TPanel.Create(self);
  pnlNov.Parent := screen;
  pnlNov.Width := 664;
  pnlNov.Height := 57;
  pnlNov.Left := 0;
  pnlNov.BevelOuter := bvNone;
  pnlNov.Top := 250 + 60 + 30;

  lbNov := TLabel.Create(self);
  lbNov.Parent := pnlNov;
  lbNov.Left := 16;
  lbNov.Layout := tlCenter;
  lbNov.Font.Style := [fsBold];
  lbNov.Font.Size := 18;
  lbNov.Caption := 'Recentes';

  showManga(397, true);

  pnlRodpe := TPanel.Create(self);
