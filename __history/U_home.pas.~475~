  end;
  pnlNavegacao.Visible := not navC;
  btnPopulares.Visible := not navC;
  btnNovidades.Visible := not navC;
  btnAz.Visible := not navC;
  lbGenero.Visible := not navC;

  navC := not navC;
end;

