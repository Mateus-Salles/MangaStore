procedure TfrmHome.FormShow(Sender: TObject);
var
  I: integer;
begin
  ar[1] := '\';
  ar[2] := '/';
  ar[3] := '*';
  ar[4] := ':';
  ar[5] := '>';
  ar[6] := '<';
  ar[7] := '"';
  ar[8] := '?';
  ar[9] := '|';

  if logado then
  begin
    pnlLogin.Visible := false;
    pnlUsua.Visible := true;
  end
  else
  begin
    pnlLogin.Visible := true;
    pnlUsua.Visible := false;
  end;

  frmHome.Activate;

  apagar();

  loadManga;

end;

