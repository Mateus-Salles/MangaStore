procedure TfrmHome.showManga(num: integer; a: boolean);
var
  opD: TOpenDialog;
  Painel, compra, pnlNome, preco, pnlImage, pnlInfo, pnlNov: TPanel;
  imgManga: TImage;
  mangaNome, lbNov: TLabel;
  sbMangas: TScrollBox;
  I, esq, C: integer;
  txt: string;
begin
  txt := GetDiretorio();

  esq := 30;

  with DM do
  begin
    if a then
    begin
      sqlManga.SQL.Text := 'SELECT * FROM mangas ORDER BY data_cadastro DESC';
    end
    else
    begin
      sqlManga.SQL.Text := 'SELECT * FROM mangas';
    end;
    sqlManga.Open;

    if tag = sqlManga.RecordCount*2 then
    begin
      tag := 0;
    end;

    opD := TOpenDialog.Create(self);

    sbMangas := TScrollBox.Create(self);
    sbMangas.Parent := screen;
    sbMangas.Height := 274;
    sbMangas.Width := 640;
    sbMangas.BevelInner := bvNone;
    sbMangas.BevelOuter := bvNone;
    sbMangas.BorderStyle := bsNone;
    sbMangas.Top := num;


    for I := 0 to sqlManga.RecordCount -1 do
    begin
      Painel := TPanel.Create(self);
      Painel.Parent := sbMangas;
      Painel.ParentColor := False;
      Painel.ParentBackground := False;
      Painel.Color := $FFFFFF;
      Painel.Width := 160;
      Painel.Height := 250;
      Painel.Left := esq;

      //Imagem
      pnlImage := TPanel.Create(self);
      pnlImage.Parent := Painel;
      pnlImage.Height := Trunc(Painel.Height * 0.6);
      pnlImage.Width := Painel.Width;
      pnlImage.Align := alTop;

      imgManga := TImage.Create(self);
      imgManga.Parent := pnlImage;
      imgManga.Width := 104;
      imgManga.Height := 104;
      imgManga.Top := Trunc((pnlImage.Height - imgManga.Height) / 2);
      imgManga.Left := Trunc((pnlImage.Width - imgManga.Width) / 2);

      imgManga.Picture.LoadFromFile(txt + '\imagens\manga\' + sqlManga.FieldByName('id_manga').AsString + renameImage() + '.jpg');

      //Nome, Preço, Compra
      pnlInfo := TPanel.Create(self);
      pnlInfo.Parent := Painel;
      pnlInfo.Height := Trunc(Painel.Height * 0.4);
      pnlInfo.Align := alBottom;

      pnlNome := TPanel.Create(self);
      pnlNome.Parent := pnlInfo;
      pnlNome.Top := 0;
      pnlNome.Align := alTop;
      pnlNome.BevelOuter := bvNone;

      mangaNome := TLabel.Create(self);
      mangaNome.Parent := pnlNome;
      mangaNome.WordWrap := True;
      mangaNome.Align := alClient;
      mangaNome.Alignment := taCenter;
      mangaNome.Font.Name := 'Lagoa7';
      mangaNome.Font.Style := [fsBold];
      mangaNome.Font.Color := $000000;
      mangaNome.Caption := sqlManga.FieldByName('titulo').AsString;

      compra := TPanel.Create(self);
      compra.Parent := pnlInfo;
      compra.ParentBackground := False;
      compra.Align := alBottom;
      compra.Color := $2175f4;
      compra.Width := 100;
      compra.Height := 30;
      compra.Caption := 'COMPRAR';
      compra.Font.Color := $000000;
      compra.Font.Style := [fsBold];
      compra.Tag := tag;
      compra.OnClick := compraManga;

      preco := TPanel.Create(self);
      preco.Parent := pnlInfo;
      preco.ParentBackground := True;
      preco.Height := 20;
      preco.Width := Painel.Width;
      preco.Top := pnlInfo.Height - 60;
      preco.BevelOuter := bvNone;
      preco.Font.Color := clBlack;
      preco.Font.Size := 12;
      preco.Caption := 'R$' + Format('%.2f', [sqlManga.FieldByName('preco').AsFloat]);

      esq := esq + Painel.Width + 20;

      if a then
      begin
        var aba: integer;

        SetLength(id, Length(id)+1);

        aba := sqlManga.RecordCount + I;

        id[aba] := sqlManga.FieldByName('id_manga').AsInteger;
      end;

      sqlManga.Next;

      tag := tag + 1;
    end;
  end;
end;

